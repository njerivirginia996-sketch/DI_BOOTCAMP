<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#edf5f1">
    <title><%= title %> | Facts Feed</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
      :root { color-scheme: light; --ink: #193b39; --muted: #687d77; --green: #267367; --coral: #ce7052; --line: #d5e2dc; --paper: #fbfdfb; }
      * { box-sizing: border-box; }
      body { min-width: 320px; min-height: 100vh; color: var(--ink); background: radial-gradient(ellipse at 86% 12%, #dceee6 0, transparent 31%), #edf5f1; font-family: 'DM Sans', 'Segoe UI', sans-serif; }
      .site-width { width: min(100% - 40px, 1080px); margin-inline: auto; }
      .site-nav { min-height: 68px; border-bottom: 1px solid var(--line); }
      .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--ink); text-decoration: none; font-size: 11px; font-weight: 700; letter-spacing: .08em; }
      .brand-mark { display: grid; width: 29px; aspect-ratio: 1; place-items: center; border: 1px solid var(--green); border-radius: 50%; color: var(--green); font-family: Georgia, serif; font-size: 17px; }
      .nav-link { color: #59716a; font-size: 13px; }
      .nav-link:hover, .nav-link.active { color: var(--green); }
      .page-main { padding-block: 40px 56px; }
      .eyebrow { margin: 0 0 8px; color: var(--green); font: 500 10px/1.5 monospace; letter-spacing: .08em; }
      h1, h2, h3 { color: var(--ink); }
      h1 { margin: 0; font-size: clamp(29px, 5vw, 43px); font-weight: 650; letter-spacing: -.035em; }
      .page-intro { max-width: 650px; margin-bottom: 28px; }
      .intro-copy { margin: 10px 0 0; color: var(--muted); font-size: 14px; line-height: 1.7; }
      .toolbar { display: flex; justify-content: space-between; align-items: end; gap: 14px; margin-bottom: 16px; padding-bottom: 12px; border-bottom: 1px solid var(--line); }
      .toolbar h2 { margin: 0; font-size: 17px; font-weight: 650; }
      .count-label { color: var(--muted); font: 10px monospace; }
      .post-list { display: grid; gap: 12px; }
      .post-item { min-width: 0; padding: 18px 20px; border: 1px solid var(--line); border-radius: 4px; background: rgba(251, 253, 251, .9); }
      .post-title { margin: 0; font-size: 17px; font-weight: 650; line-height: 1.35; }
      .post-title a { color: var(--ink); text-decoration: none; }
      .post-title a:hover { color: var(--green); text-decoration: underline; text-underline-offset: 3px; }
      .post-meta { display: flex; flex-wrap: wrap; gap: 6px 14px; margin: 9px 0 0; color: var(--muted); font: 10px/1.6 monospace; }
      .post-content { margin: 12px 0 0; color: #536a63; font-size: 13px; line-height: 1.7; overflow-wrap: anywhere; }
      .category-list { display: flex; flex-wrap: wrap; gap: 5px; }
      .category-tag { color: #92543e; }
      .search-panel { padding: 18px 0 21px; border-bottom: 1px solid var(--line); }
      .search-panel:first-child { padding-top: 0; }
      .search-panel h2 { margin: 0 0 13px; font-size: 15px; font-weight: 650; }
      .form-label { color: #4e6861; font-size: 11px; font-weight: 600; }
      .form-control, .form-select { min-height: 42px; border-color: #c7d9d0; border-radius: 3px; font-size: 13px; }
      .form-control:focus, .form-select:focus { border-color: var(--green); box-shadow: 0 0 0 .2rem rgba(38, 115, 103, .12); }
      .btn-search { min-height: 40px; padding-inline: 16px; border: 1px solid var(--green); border-radius: 3px; background: var(--green); color: white; font-size: 12px; font-weight: 600; }
      .btn-search:hover { border-color: #1c5d54; background: #1c5d54; color: white; }
      .results-section { padding-top: 27px; }
      .notice { padding: 12px 14px; border-left: 3px solid var(--coral); background: #fff8f4; color: #7c503f; font-size: 12px; }
      .empty-state { padding: 24px 0; color: var(--muted); font-size: 13px; }
      .site-footer { min-height: 56px; display: flex; align-items: center; border-top: 1px solid var(--line); color: #82938d; font: 9px monospace; }
      @media (max-width: 575px) { .site-width { width: min(100% - 28px, 1080px); } .page-main { padding-block: 30px 40px; } .post-item { padding: 15px; } .toolbar { align-items: start; flex-direction: column; } }
    </style>
  </head>
  <body>
